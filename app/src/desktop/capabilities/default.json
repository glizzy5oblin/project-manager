{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Permissions for the main window: core events, the folder picker, and opening GitHub's device sign-in page",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "dialog:allow-open",
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                {
                    "url": "https://github.com/login/device"
                }
            ]
        }
    ]
}
